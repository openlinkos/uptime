[Unit]
Description=LinkOS Status mainland probe
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# GATUS_URL、PROBE_GROUP、PROBE_TOKEN；文件只有 root 可读，由 systemd 读入后以临时用户运行脚本
EnvironmentFile=/etc/linkos-probe/env
ExecStart=/usr/local/bin/linkos-probe
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# 每项最长 15 秒、失败重试一次，最坏约 3.5 分钟，仍在 Gatus 的 5 分钟心跳之内
TimeoutStartSec=240s
